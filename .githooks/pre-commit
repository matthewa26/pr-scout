#!/usr/bin/env bash
# Runs the test suite before allowing a commit. To enable, run:
#   ./scripts/setup-dev.sh
# (or manually: git config core.hooksPath .githooks)

set -euo pipefail

if ! command -v swift >/dev/null 2>&1; then
    echo "pre-commit: 'swift' not found on PATH; skipping tests." >&2
    exit 0
fi

echo "pre-commit: running swift test..."
swift test --quiet
